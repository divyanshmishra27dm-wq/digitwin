PORT=5004
MONGODB_URI=mongodb://127.0.0.1:27017/niit-digital-twin
JWT_SECRET=change-this-to-a-long-random-string

# This app calls a LiteLLM proxy, not OpenAI directly. Leave LITELLM_API_KEY
# empty to run in DEMO MODE (curated canned answers from
# server/services/demoService.js — no external calls at all).
LITELLM_BASE_URL=https://litellm.niit.com/v1
LITELLM_API_KEY=
LITELLM_MODEL=azure-gpt-l1

ADMIN_EMAIL=admin@niit.com
ADMIN_PASSWORD=ChangeMe123!
DEMO_USER_EMAIL=user@niit.com
DEMO_USER_PASSWORD=ChangeMe123!
CLIENT_URL=http://localhost:5173
