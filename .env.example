# ── Server ────────────────────────────────────────────────
PORT=5004

# MongoDB connection string. Never commit real credentials.
MONGODB_URI=mongodb://127.0.0.1:27017/niit-digital-twin

# JWT signing secret — set a long random string in real environments.
JWT_SECRET=change-this-to-a-long-random-string

# ── AI (optional) ────────────────────────────────────────────
# This app calls a LiteLLM proxy, not OpenAI directly. Leave LITELLM_API_KEY
# empty to run in DEMO MODE (curated canned answers from
# server/services/demoService.js — no external calls at all).
LITELLM_BASE_URL=https://litellm.niit.com/v1
LITELLM_API_KEY=
LITELLM_MODEL=azure-gpt-l1

# ── Seed credentials ─────────────────────────────────────────
# Used only by `npm run seed`. Do not commit real credentials.
ADMIN_EMAIL=admin@niit.com
ADMIN_PASSWORD=ChangeMe123!
DEMO_USER_EMAIL=user@niit.com
DEMO_USER_PASSWORD=ChangeMe123!

# ── Client ────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Public / Shared Twin Access Key ──────────────────────────
# Shareable key that allows external access to all digital twins across all departments
SHARED_ACCESS_KEY=ndt_twin_access_key_99
